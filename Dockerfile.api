FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENVIRONMENT=production AUTH_PROVIDER=supabase
WORKDIR /app
COPY requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt
COPY backend ./backend
COPY database ./database
COPY config ./config
RUN useradd --create-home --uid 10001 scope && mkdir -p /data /app/uploads /app/reports /app/chromadb_storage && chown -R scope:scope /data /app/uploads /app/reports /app/chromadb_storage
USER scope
EXPOSE 8000
CMD ["uvicorn","backend.main:app","--host","0.0.0.0","--port","8000","--no-access-log","--timeout-keep-alive","30"]
