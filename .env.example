# AI Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Evidence workspace: enable explicitly after entering the key privately.
# WORKSPACE_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash

# Third-party APIs
SERPER_API_KEY=your_serper_api_key_here

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
# Required for signed receipt; WhatsApp commands are unavailable.
# WHATSAPP_APP_SECRET=

# Environment
ENVIRONMENT=development
# Primary cloud workspace; hybrid preserves separate local development accounts.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# JOB_DATABASE=supabase
# JOB_WORKER_MODE=external
# FIRECRAWL_API_KEY=
# Optional official X recent-search access; store this privately on the backend.
# X_BEARER_TOKEN=
# Internal read-only Calendly adapter. Never put the token in NEXT_PUBLIC settings.
# CALENDLY_ACCESS_TOKEN=
# Exact Whistle identity: local:<numeric-user-id> or cloud:<Supabase-user-uuid>.
# CALENDLY_ACCOUNT_SCOPE=
# Token scopes: users:read and scheduled_events:read. Public SaaS needs per-user OAuth.
# Product Hunt public feed needs no key. Full API commercial access requires approval.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# SENTRY_DSN=
# FRONTEND_URL=http://127.0.0.1:3000
# CELERY_BROKER_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///./antigravity.db
# Production database (set instead of the local SQLite URL):
# DATABASE_URL=postgresql+psycopg://vc_scope:YOUR_PRIVATE_PASSWORD@127.0.0.1:5432/vc_scope
# POSTGRES_PASSWORD=YOUR_PRIVATE_PASSWORD

# Required in production. Set a private, randomly generated value (never commit it).
# JWT_SECRET=
# Production requires AUTH_PROVIDER=supabase. No accounts are seeded on startup.
# Cloud team access is off until the fund migration and actual signed-in flows are verified.
# FUND_ACCESS_ENABLED=false

# Optional OpenAI-compatible endpoint for a local or hosted open-source model.
# WORKSPACE_MODEL_URL=http://127.0.0.1:11434/v1
# WORKSPACE_MODEL=your-installed-model
# WORKSPACE_MODEL_KEY=
